{
    "manufacturer": "waveshare",
    "type": "esp32-s3-touch-lcd-3.5b",
    "target": "esp32s3",
    "builds": [
        {
            "name": "esp32-s3-touch-lcd-3.5b",
            "sdkconfig_append": [
                "CONFIG_GATEWAY_MANAGER=y",
                "CONFIG_PHONE_BRIDGE_UART=n",
                "CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y",
                "CONFIG_ESP_CONSOLE_SECONDARY_NONE=y",
                "CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=32",
                "CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y",
                "CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=6",
                "CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6",
                "CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32",
                "CONFIG_ESP_WIFI_RX_BA_WIN=6",
                "CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384",
                "CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096",
                "CONFIG_MBEDTLS_DYNAMIC_BUFFER=n",
                "CONFIG_MBEDTLS_HARDWARE_AES=n",
                "CONFIG_HEAP_POISONING_LIGHT=y",
                "CONFIG_LWIP_SO_RCVBUF=y",
                "CONFIG_LWIP_TCP_TMR_INTERVAL=100",
                "CONFIG_LWIP_TCP_RTO_TIME=600",
                "CONFIG_LWIP_UDP_RECVMBOX_SIZE=32",
                "CONFIG_BT_ENABLED=y",
                "CONFIG_BT_BLUEDROID_ENABLED=y",
                "CONFIG_BT_ALLOCATION_FROM_SPIRAM_FIRST=y",
                "CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y",
                "CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y",
                "CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y",
                "CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y",
                "CONFIG_BT_BLE_50_FEATURES_SUPPORTED=n",
                "CONFIG_BT_BLE_42_FEATURES_SUPPORTED=y",
                "CONFIG_USE_WECHAT_MESSAGE_STYLE=y",
                "CONFIG_CAMERA_OV2640=y",
                "CONFIG_CAMERA_OV2640_AUTO_DETECT_DVP_INTERFACE_SENSOR=y",
                "CONFIG_CAMERA_OV2640_DVP_YUV422_640X480_6FPS=y",
                "CONFIG_CAMERA_OV2640_DVP_IF_FORMAT_INDEX_DEFAULT=1",
                "CONFIG_CAMERA_OV5640=y",
                "CONFIG_CAMERA_OV5640_AUTO_DETECT_DVP_INTERFACE_SENSOR=y",
                "CONFIG_CAMERA_OV5640_DVP_YUV422_800X600_10FPS=y",
                "CONFIG_CAMERA_OV5640_DVP_IF_FORMAT_INDEX_DEFAULT=0",
                "CONFIG_SR_NSN_NSNET2=y"
            ]
        }
    ]
}
